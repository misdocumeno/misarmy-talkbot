discovery.docker "talkbot" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "name"
    values = ["misarmy-talkbot-misarmy_talkbot-1", "misarmy_talkbot"]
  }
}

discovery.relabel "talkbot" {
  targets = discovery.docker.talkbot.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    target_label  = "container"
  }
  rule {
    target_label = "service"
    replacement  = "misarmy-talkbot"
  }
}

loki.source.docker "talkbot" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.talkbot.output
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
