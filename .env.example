# Copy to .env and fill in values. Compose loads this via env_file.

# Required
DISCORD_TOKEN=

# Lavalink (defaults match docker-compose)
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

# Shared TTS audio directory (legacy janitor only; hot path is in-memory HTTP)
AUDIO_DIR=/tmp/talkbot-audio
AUDIO_TTL_SECONDS=600
AUDIO_JANITOR_INTERVAL_SECONDS=120

# In-memory HTTP bridge so Lavalink can pull TTS without disk I/O.
# PUBLIC_BASE must be reachable from the Lavalink container.
AUDIO_HTTP_HOST=0.0.0.0
AUDIO_HTTP_PORT=8765
AUDIO_HTTP_PUBLIC_BASE=http://misarmy_talkbot:8765

# Playback / ops
TTS_MAX_CONCURRENT=2
# EDGE_TTS_MAX_ATTEMPTS=4
# EDGE_TTS_RETRY_BACKOFF_SECONDS=1.5
GRACE_DROP_SECONDS=60
OPS_ANNOUNCE_COOLDOWN_SECONDS=300
METRICS_SNAPSHOT_INTERVAL_SECONDS=300

# Azure Speech (optional). When set, ms/ voices use Azure first and
# fall back to edge-tts if the monthly soft cap is hit or Azure errors.
# Create a Speech resource in Azure Portal → Keys and Endpoint.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastus
# AZURE_SPEECH_MONTHLY_CAP=500000
# Soft-cap period: match Speech resource → Pricing tier (often day 1).
# AZURE_SPEECH_QUOTA_MONTH_DAY=1
# AZURE_SPEECH_QUOTA_TZ=UTC

# Google Cloud Text-to-Speech (optional). When set, google/ lists Cloud voices
# only (Standard/WaveNet/Neural2/Chirp3 — Studio/Gemini excluded). On soft-cap
# or errors the bot uses gTTS as a substitute (not listed) and replies with an
# orange embed. Chirp streams; others are one-shot MP3.
# Soft caps are per billing SKU (0 = unlimited for that bucket):
#   Standard+WaveNet share 4M free; Neural2 and Chirp3 each 1M free.
# Studio is $160/1M after 1M free — off unless explicitly allowed.
# GOOGLE_TTS_API_KEY=
# GOOGLE_TTS_VOICE_TIER=all
# GOOGLE_TTS_ALLOW_STUDIO=0
# GOOGLE_TTS_CAP_STANDARD_WAVENET=4000000
# GOOGLE_TTS_CAP_NEURAL2=1000000
# GOOGLE_TTS_CAP_CHIRP3=1000000
# GOOGLE_TTS_CAP_STUDIO=1000000
# GOOGLE_TTS_QUOTA_MONTH_DAY=1
# GOOGLE_TTS_QUOTA_TZ=UTC
# Legacy: GOOGLE_TTS_MONTHLY_CAP still sets Neural2+Chirp3 if the CAP_* vars
# above are unset.

# Bot operator allowlist (your Discord user + guild only). Empty = deny.
# Gates /recover, /status, /tts-usage, /sync, /debug. Not Discord "guild owner".
BOT_OWNER_USER_IDS=354114876526034944
BOT_OWNER_GUILD_IDS=814851486621106198
# Legacy aliases (used if BOT_OWNER_* unset):
# TTS_USAGE_ALLOWED_USER_IDS=354114876526034944
# TTS_USAGE_ALLOWED_GUILD_IDS=814851486621106198

# Logging (stdout/stderr only; use `docker compose logs` in Docker)
LOG_LEVEL=INFO
# text (default) or json (for Loki via observability profile)
# LOG_FORMAT=json

# Prometheus scrape endpoint inside the compose network (0 disables)
# METRICS_HTTP_PORT=9100
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318/v1/traces
# OTEL_SERVICE_NAME=misarmy-talkbot
# STALL_NO_PROGRESS_SEC=30
# STALL_TTS_ZERO_PROGRESS_SEC=60
# Grafana (prod compose). Prefer GitHub OAuth over password login.
# GRAFANA_PORT=3000
# GRAFANA_ROOT_URL=http://192.168.100.6:3000
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=talkbot
# Break-glass password login (set false + DISABLE_LOGIN_FORM=true after OAuth works):
# GRAFANA_BASIC_AUTH=true
# GRAFANA_DISABLE_LOGIN_FORM=false
# GitHub OAuth App → Authorization callback URL = $GRAFANA_ROOT_URL/login/github
# GRAFANA_GITHUB_ENABLED=true
# GRAFANA_GITHUB_ALLOW_SIGN_UP=true
# GRAFANA_GITHUB_CLIENT_ID=
# GRAFANA_GITHUB_CLIENT_SECRET=
# Optional lockdown (GitHub org slug and/or team numeric IDs):
# GRAFANA_GITHUB_ALLOWED_ORGS=
# GRAFANA_GITHUB_TEAM_IDS=
# GRAFANA_AUTO_ORG_ROLE=Admin

# Gettext locale for slash command text and sidebar presence (not global.jsonc)
# LANG=es_AR

# Debug overlay only (docker-compose.debug.yml)
# ENABLE_DEBUGPY=1
# DEBUGPY_PORT=5678
# DEBUGPY_WAIT_FOR_CLIENT=0
